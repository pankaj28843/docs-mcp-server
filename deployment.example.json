{
  "infrastructure": {
    "mcp_host": "0.0.0.0",
    "mcp_port": 42042,
    "default_client_model": "claude-haiku-4.5",
    "max_concurrent_requests": 20,
    "uvicorn_workers": 1,
    "uvicorn_limit_concurrency": 200,
    "log_level": "info",
    "log_profile": "default",
    "log_profiles": {
      "default": {
        "level": "info",
        "json_output": true,
        "trace_categories": [],
        "trace_level": "debug",
        "logger_levels": {
          "uvicorn.access": "warning",
          "fastmcp": "warning",
          "mcp.server": "warning"
        },
        "access_log": false
      },
      "trace-drftest": {
        "level": "debug",
        "json_output": true,
        "trace_categories": [
          "docs_mcp_server",
          "uvicorn.error",
          "uvicorn.access"
        ],
        "trace_level": "debug",
        "logger_levels": {
          "docs_mcp_server.search.segment_search_index": "debug"
        },
        "access_log": true
      }
    },
    "observability_collector": {
      "enabled": false,
      "otlp_protocol": "http",
      "collector_endpoint": "http://localhost:6006/v1/traces",
      "headers": {},
      "timeout_seconds": 10,
      "grpc_insecure": true,
      "resource_attributes": {
        "service.name": "docs-mcp-server"
      }
    },
    "operation_mode": "online",
    "http_timeout": 120,
    "search_timeout": 30,
    "search_include_stats": true,
    "browser_cdp_endpoint": "http://127.0.0.1:9222",
    "sync_concurrency_limit": 8,
    "crawler_proxy_attempt_timeout_seconds": 45,
    "article_proxies": "",
    "article_extractor_fallback": {
      "enabled": false,
      "endpoint": "http://10.20.30.1:13005/",
      "timeout_seconds": 20,
      "batch_size": 1,
      "max_retries": 2,
      "api_key_env": "DOCS_FALLBACK_EXTRACTOR_TOKEN"
    }
  },
  "tenants": [
    {
      "source_type": "online",
      "codename": "django",

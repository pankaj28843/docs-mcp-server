[Unit]
Description=Read-only documentation search daemon
After=network.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=%h/.local/bin/docsearchd
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
